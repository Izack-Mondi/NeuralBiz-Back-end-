# Database
DATABASE_URL="postgresql://user:password@localhost:5432/neuralbiz?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Media storage and processing
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3000/storage
LOCAL_UPLOAD_SECRET=replace-with-a-long-random-local-secret
REDIS_HOST=localhost
REDIS_PORT=6379
MAX_VIDEO_BYTES=314572800
MAX_VIDEO_DURATION_SEC=600
MAX_IMAGE_BYTES=10485760
MAX_CONCURRENT_UPLOADS=5
UPLOAD_URL_EXPIRES_IN=3600
VIDEO_PROCESSING_TIMEOUT_MS=900000
TEMP_DIR=./temp

# Optional local-only integration test database.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/neuralbiz_test?schema=public

# Production requires STORAGE_DRIVER=r2 or s3, all R2_* values below,
# REDIS_HOST, REDIS_PORT, and CORS_ORIGINS for both web and worker services.
# Optional Cloudflare R2 configuration for local development.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=neuralbiz-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+25415713684

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
