{
  "name": "nexify-back-end",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "ts-node src/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/assert-dev-db.js && prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node scripts/assert-dev-db.js && ts-node prisma/seed.ts",
    "test:int": "node scripts/assert-dev-db.js && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/feed.integration.spec.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.3",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.22.0",
    "@types/rimraf": "^3.0.2",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "blurhash": "^2.0.5",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "graphql-depth-limit": "^1.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "5.22.0",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "twilio": "^6.1.1",
    "uuid": "^14.0.2"
  },
